{
	"name": "codebuddy-cli-launcher",
	"displayName": "CodeBuddy CLI 启动器",
	"description": "编辑器标题栏、命令面板与资源管理器一键在独立分组终端中启动 CodeBuddy CLI (cbc)，终端复用、纯净无依赖",
	"version": "1.1.0",
	"publisher": "jdgmr",
	"repository": {
		"type": "git",
		"url": "https://github.com/younguis/codebuddy-cli-launcher.git"
	},
	"icon": "assets/icon.png",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./extension.js",
	"contributes": {
		"commands": [
			{
				"command": "codebuddyCli.launch",
				"title": "启动终端",
				"category": "CodeBuddy CLI",
				"icon": {
					"light": "assets/icon-titlebar.png",
					"dark": "assets/icon-titlebar.png"
				}
			},
			{
				"command": "codebuddyCli.launchHere",
				"title": "在此文件夹启动",
				"category": "CodeBuddy CLI"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "codebuddyCli.launch",
					"group": "navigation"
				}
			],
			"explorer/context": [
				{
					"command": "codebuddyCli.launchHere",
					"when": "explorerResourceIsFolder",
					"group": "navigation"
				}
			]
		}
	}
}
